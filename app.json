{
  "expo": {
    "name": "Ibn Firnas",
    "slug": "ibnfirnas-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ibnfirnasfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon-adaptive-foreground.png",
        "monochromeImage": "./assets/images/icon-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ibnfirnas.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withSplashScreenIconBehavior.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "backgroundColor": "#F4F7FC"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47ff0002-cbc1-4616-aa8d-d9ebe504e6a7"
      }
    },
    "owner": "aqeel54"
  }
}
